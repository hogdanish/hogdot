# The three refs the entire port derivation depends on. Sourced by hogdot/*.sh.
#
# Bump UPSTREAM_BASE when rebasing the fork onto a newer mainline release.
# Bump WEBGPU_REF/WEBGPU_FORK_POINT only if dwalter re-bases GodotWebGPU itself.
#
# Invariant: WEBGPU_FORK_POINT must be the exact merge-base of WEBGPU_REF and
# mainline. Verify with:  git merge-base --is-ancestor "$WEBGPU_FORK_POINT" "$WEBGPU_REF"
# As of 2026-08-06 GodotWebGPU branched cleanly at 4.6.2-stable with zero merge
# commits, which is what makes `git diff FORK_POINT WEBGPU_REF` the complete,
# unambiguous WebGPU delta.

# Mainline Godot release hogdot currently tracks.
HOGDOT_UPSTREAM_BASE=4.7.2-stable

# The GodotWebGPU branch we are porting FROM (remote-tracking ref, read-only).
HOGDOT_WEBGPU_REF=webgpu/webgpu-4.6.2

# The mainline release GodotWebGPU itself forked from.
HOGDOT_WEBGPU_FORK_POINT=4.6.2-stable
